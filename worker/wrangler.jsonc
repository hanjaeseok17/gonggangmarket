{
  // 공강마켓 백엔드. 설계서 10장 참조.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gonggang-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gonggang",
      // 실제 배포 전에 `wrangler d1 create gonggang`으로 받은 id를 넣는다
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "gonggang-media" },
    { "binding": "ID_CARDS", "bucket_name": "gonggang-id-cards" }
  ],
  "vars": { "ENVIRONMENT": "development" }
}
